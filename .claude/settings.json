{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "共有設定。deny だけで権限を制限し、何も自動承認しない。許可を増やす場合は各自 settings.local.json（gitignore 済み）へ。",
  "permissions": {
    "deny": [
      "Read(./registry/MASK_MAP.yaml)",
      "Read(./cases/*/*/raw/**)",
      "Read(./cases/*/*/requirements/raw/**)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/id_rsa)"
    ]
  },
  "_comment_hooks": "PreToolUse: AI の raw/ 直接アクセスを遮断。PostToolUse: 成果物 YAML を書いた直後に人読版を再生成し、門番を回して ERROR だけを表示（exit 0 固定・作業を止めない）。",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_start.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_raw.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_artifact.py\"",
            "timeout": 60,
            "statusMessage": "門番を確認中…"
          }
        ]
      }
    ]
  }
}
